{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Agent(*)",
      "WebFetch(*)",
      "WebSearch(*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'export HOME=/c/Users/jk023; bash /c/Users/jk023/nexus-lab/scripts/subagent_write_gate.sh'",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash -lc 'export HOME=/c/Users/jk023; bash /c/Users/jk023/nexus-lab/scripts/zen_semantic_check_hook.sh'",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'export HOME=/c/Users/jk023; bash /c/Users/jk023/nexus-lab/scripts/zen_bash_audit_advisory.sh'",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'export HOME=/c/Users/jk023; /c/Users/jk023/nexus-lab/scripts/zen_session_start_priming.sh'",
            "timeout": 5,
            "statusMessage": "Zen session priming..."
          }
        ]
      }
    ]
  }
}
