{
  "name": "my-mcp-server",
  "version": "0.1.0",
  "type": "module",
  "description": "MCP server template with typed config: env / file / profile, schema-validated at startup",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch & node --watch dist/index.js",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@nexus-lab/mcp-toolkit": "^0.1.0",
    "dotenv": "^16.4.7",
    "smol-toml": "^1.3.1",
    "yaml": "^2.6.1",
    "zod": "^3.24.2"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^3.0.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
