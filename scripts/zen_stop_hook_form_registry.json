{
  "version": 0,
  "purpose": "zen_stop_hook.sh の検出器が依存する form の正本。form (= ファイル命名 / frontmatter フィールド / 出力の形 / state surface) を変えたら、その form を読む検出器を同一変更内で更新する契約 (drift.md 18段目)。smoke test scripts/test_zen_stop_hook_forms.sh が本 registry と hook 実体の一致を機械照合する。本 registry にあって hook に無い literal (= form が rename/変更されたのに registry 未更新)、または hook の主要 form が registry に無い (= 新 form 追加で registry 未更新) を検出したら loud に fail する。",
  "hook_path": "scripts/zen_stop_hook.sh",
  "hook_line_count_at_authoring": 960,
  "conventions": {
    "literal_matching": "各 form の literal は hook ソースに逐語で実在する文字列 (= smoke test が fgrep -F で照合する)。${TODAY} や ${VAR} を含む literal は『展開前の hook ソース文字列』に合わせている。hook 内で `${TODAY}` は date +%Y-%m-%d に展開されるが、registry は展開前ソースを正とする。smoke test 側は fixture を実 TODAY で生成しつつ、registry↔hook の逐語照合は展開前ソースに対して行うことで両立させる (test の README コメント参照)。",
    "kind": {
      "glob": "find -name / mapfile で使う file 命名 pattern (input)",
      "glob_exclude": "find ! -name / -not / grep 除外に使う命名 pattern",
      "frontmatter": "file 本文の frontmatter / 行頭フィールド read (awk/grep で抜く)",
      "grep_pattern": "LAST_OUTPUT / 本文への正規表現 match (awk ~ /.../ or grep -E)",
      "md_name": "Aira evaluator 等、参照する固定 md/json file 名",
      "state_surface": "state を読む固定 path の末尾 file 名 / 見出しフィールド",
      "literal_string": "出力テキストや mode 宣言など、その他の逐語 form"
    },
    "role_prefix": "input = 検出の入力、exclude = 除外条件、resolve = 解決/応答リンク、read = 値の読み取り"
  },
