{
  "name": "@nexus-lab/aira",
  "version": "0.1.0",
  "description": "Aira Phase 0 mini — read-only digest synthesis layer (internal only, not for public distribution). Yuino 商品化版 src は同 dir 内に共存 (post-連休 で packages/yuino/ に migration candidate)",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "digest": "node --loader ts-node/esm src/digest.ts",
    "digest:dry": "DRY_RUN=true node --loader ts-node/esm src/digest.ts",
    "yuino:cli": "node --loader ts-node/esm cli/index.ts",
    "yuino:digest:dry": "node --loader ts-node/esm cli/index.ts digest --dry-run"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "prompts": "^2.4.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^2.0.0"
  }
}
